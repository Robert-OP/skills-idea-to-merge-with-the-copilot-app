---
---
<section id="bookmark-manager" aria-labelledby="bookmark-title">
  <div class="intro">
    <span class="eyebrow">YOUR PERSONAL LINK LIBRARY</span>
    <h2 id="bookmark-title">Keep the good ones close.</h2>
    <p>One link in, one memorable Mona slug out.</p>
  </div>

  <form id="add-bookmark">
    <div class="field">
      <label for="url">Link to save</label>
      <input
        id="url"
        name="url"
        type="text"
        inputmode="url"
        autocomplete="url"
        spellcheck="false"
        placeholder="example.com/article"
        required
      />
    </div>
    <button type="submit">Add bookmark <span aria-hidden="true">↗</span></button>
  </form>

  <p class="hint">A missing scheme becomes <code>https://</code>. Existing HTTP(S) links stay as they are.</p>
  <p id="bookmark-status" class="status" role="status" aria-live="polite"></p>

  <div id="list-header" hidden>
    <div>
      <h2 class="list-title">Saved bookmarks</h2>
      <p id="bookmark-count" class="bookmark-count"></p>
    </div>
    <button id="clear-all" type="button" class="clear">Clear all</button>
  </div>

  <p id="empty-state" class="empty">
    <span class="empty-mark" aria-hidden="true">✳</span>
    <strong>Your next favorite is one link away.</strong>
    <span>Add a URL above and its short slug will show up here.</span>
  </p>

  <ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite"></ul>
</section>

<script>
  import {
    formatBookmark,
    generateSlug,
    loadBookmarks,
    normalizeUrl,
    STORAGE_KEY,
  } from '../utils/bookmarks.js';

  function getRequiredElement<T extends HTMLElement>(selector: string): T {
    const element = document.querySelector<T>(selector);
    if (!element) throw new Error(`Missing bookmark manager element: ${selector}`);
    return element;
  }

  const form = getRequiredElement<HTMLFormElement>('#add-bookmark');
  const input = getRequiredElement<HTMLInputElement>('#url');
  const bookmarkList = getRequiredElement<HTMLUListElement>('#bookmark-list');
  const emptyState = getRequiredElement<HTMLParagraphElement>('#empty-state');
  const listHeader = getRequiredElement<HTMLDivElement>('#list-header');
  const bookmarkCount = getRequiredElement<HTMLParagraphElement>('#bookmark-count');
  const status = getRequiredElement<HTMLParagraphElement>('#bookmark-status');
  const clearAll = getRequiredElement<HTMLButtonElement>('#clear-all');

  function readBookmarks() {
    try {
      return loadBookmarks(window.localStorage.getItem(STORAGE_KEY));
    } catch {
      return [];
    }
  }

  let bookmarks = readBookmarks();

  function setStatus(message: string) {
    status.textContent = message;
  }

  function persistBookmarks() {
    try {
      window.localStorage.setItem(STORAGE_KEY, JSON.stringify(bookmarks));
      return true;
    } catch {
      setStatus('This browser could not save your bookmarks. They will be lost when you leave this page.');
      return false;
    }
  }

  function renderBookmarks() {
    const rows = bookmarks.map((bookmark) => {
      const item = document.createElement('li');
      item.className = 'bookmark';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = bookmark.url;

      const separator = document.createElement('span');
      separator.className = 'separator';
      separator.setAttribute('aria-hidden', 'true');
      separator.textContent = ' :: ';

      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;

      const copyButton = document.createElement('button');
      copyButton.className = 'copy';
      copyButton.type = 'button';
      copyButton.textContent = 'Copy slug';
      copyButton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          setStatus(`Copied ${bookmark.slug} to the clipboard.`);
        } catch {
          setStatus('Could not access the clipboard. Select and copy the slug instead.');
        }
      });

      item.append(link, separator, slug, copyButton);
      return item;
    });

    bookmarkList.replaceChildren(...rows);
    const hasBookmarks = bookmarks.length > 0;
    emptyState.hidden = hasBookmarks;
    listHeader.hidden = !hasBookmarks;
    bookmarkCount.textContent = `${bookmarks.length} ${bookmarks.length === 1 ? 'bookmark' : 'bookmarks'}`;
  }

  form.addEventListener('submit', (event) => {
    event.preventDefault();

    try {
      const url = normalizeUrl(input.value);
      bookmarks = [...bookmarks, { url, slug: generateSlug() }];
      const saved = persistBookmarks();
      renderBookmarks();
      input.value = '';
      if (saved) {
        setStatus(`Saved ${formatBookmark(bookmarks[bookmarks.length - 1])}`);
      }
    } catch {
      setStatus('Enter a valid HTTP or HTTPS URL, such as example.com/article.');
      input.focus();
    }
  });

  clearAll.addEventListener('click', () => {
    if (bookmarks.length === 0 || !window.confirm('Clear all saved bookmarks?')) return;

    bookmarks = [];
    const saved = persistBookmarks();
    renderBookmarks();
    if (saved) setStatus('All bookmarks cleared.');
  });

  renderBookmarks();
</script>

<style is:global>
  #bookmark-manager {
    --card: color-mix(in srgb, currentColor 3%, transparent);
    --accent-soft: color-mix(in srgb, var(--accent) 12%, transparent);
    margin-top: 2rem;
  }

  #bookmark-manager .intro {
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) * 1.5);
    background:
      radial-gradient(ellipse at 92% 8%, var(--accent-soft), transparent 45%),
      var(--card);
  }

  #bookmark-manager .eyebrow {
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  #bookmark-manager .intro h2 {
    margin: 0.55rem 0 0.25rem;
    font-family: var(--font-head);
    font-size: clamp(1.35rem, 5vw, 1.8rem);
    letter-spacing: -0.035em;
  }

  #bookmark-manager .intro p {
    margin: 0;
    color: var(--muted);
  }

  #bookmark-manager form {
    margin-top: 1.25rem;
  }

  #bookmark-manager form button {
    white-space: nowrap;
  }

  #bookmark-manager form button span {
    margin-left: 0.35rem;
  }

  #bookmark-manager .hint,
  #bookmark-manager .status {
    min-height: 1.2em;
    margin: 0.65rem 0 1.5rem;
    color: var(--muted);
    font-size: 0.78rem;
  }

  #bookmark-manager .status:empty {
    display: none;
  }

  #bookmark-manager .status:not(:empty) {
    color: var(--accent);
  }

  #bookmark-manager #list-header {
    margin: 2rem 0 0.75rem;
  }

  #bookmark-manager .list-title {
    margin: 0;
    font-family: var(--font-head);
    font-size: 1rem;
  }

  #bookmark-manager .bookmark-count {
    margin: 0.1rem 0 0;
    color: var(--muted);
    font-size: 0.75rem;
  }

  #bookmark-manager .clear,
  #bookmark-manager .copy {
    border-color: var(--border);
    background: transparent;
    color: inherit;
    font-size: 0.75rem;
    font-weight: 500;
  }

  #bookmark-manager .clear {
    padding: 0.35rem 0.7rem;
  }

  #bookmark-manager ul {
    display: grid;
    gap: 0.55rem;
  }

  #bookmark-manager li.bookmark {
    gap: 0.45rem 0;
    padding: 0.8rem;
    background: var(--card);
  }

  #bookmark-manager .bookmark .url {
    flex: 1 1 100%;
    color: inherit;
    text-decoration-color: var(--border);
    text-underline-offset: 0.2em;
  }

  #bookmark-manager .bookmark .url:hover {
    color: var(--accent);
  }

  #bookmark-manager .separator {
    color: var(--muted);
    white-space: pre;
  }

  #bookmark-manager .bookmark .slug {
    background: var(--accent-soft);
    color: var(--accent);
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 700;
  }

  #bookmark-manager .copy {
    margin-left: auto;
    padding: 0.28rem 0.55rem;
  }

  #bookmark-manager .empty {
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    margin: 1rem 0 0;
    padding: 2rem 1rem;
    border-color: var(--border);
    color: var(--muted);
  }

  #bookmark-manager .empty[hidden],
  #bookmark-manager #list-header[hidden] {
    display: none;
  }

  #bookmark-manager .empty strong {
    color: inherit;
    font-weight: 600;
  }

  #bookmark-manager .empty-mark {
    margin-bottom: 0.25rem;
    color: var(--accent);
    font-size: 1.5rem;
  }
</style>
